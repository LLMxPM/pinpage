{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PinPage",
  "version": "0.1.0",
  "identifier": "com.pinpage.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "capabilities": ["manager"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "轻量网页悬浮工具",
    "category": "Utility",
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"]
  }
}
