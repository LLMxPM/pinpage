# 功能：排除依赖、构建产物、运行数据和个人环境文件。

# 前端依赖与构建缓存
node_modules/
dist/
.vite/
.pnpm-store/
coverage/
*.tsbuildinfo

# Rust / Tauri 构建产物和生成文件
/target/
/src-tauri/target/
/src-tauri/gen/schemas/
/src-tauri/permissions/autogenerated/

# Python 辅助工具环境与缓存
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# 本地配置、日志和运行数据
.env
.env.*
!.env.example
!.env.*.example
*.log
/logs/
/tmp/
/runtime-data/
/release-notes.md
/docs/updater-signing.local.md
/WebView2/
*.WebView2/
# updater 私钥及密码只能保存在仓库之外，防止误加入。
*.key
*.password

# 编辑器与操作系统文件
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
