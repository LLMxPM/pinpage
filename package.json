{
  "name": "pinpage",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "version:set": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs --check",
    "test:release": "node --test tests/release.test.mjs",
    "release:build": "node scripts/build-signed.mjs",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "check": "vue-tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "format": "prettier --write src locales scripts examples tests index.html vite.config.ts package.json tsconfig.json src-tauri/tauri.conf.json src-tauri/capabilities",
    "format:check": "prettier --check src locales scripts examples tests index.html vite.config.ts package.json tsconfig.json src-tauri/tauri.conf.json src-tauri/capabilities",
    "build": "pnpm check:i18n && pnpm check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:ui": "node --experimental-strip-types --test tests/pin-actions.test.mjs tests/pin-settings-form.test.mjs tests/pin-source-draft.test.mjs tests/window-editor.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.18"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.9.10",
    "semver": "^7.8.6",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vue-tsc": "^3.3.14"
  }
}
